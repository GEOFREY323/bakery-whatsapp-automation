    {
      "parameters": {
        "jsCode": "const orders = $input.all().map(i => i.json);\n\nconst count = orders.length;\n\nconst itemTotals = {};\nfor (const order of orders) {\n  // Match your sheet column headers exactly: \"Items\" with capital I\n  let items = order.Items || order.items;\n  \n  if (!items) continue;\n  \n  if (typeof items === 'string') {\n    try {\n      items = JSON.parse(items);\n    } catch (e) {\n      continue;\n    }\n  }\n  \n  if (Array.isArray(items)) {\n    for (const it of items) {\n      const name = it.name || it.item || 'unknown';\n      const qty = Number(it.quantity || it.qty || 1);\n      itemTotals[name] = (itemTotals[name] || 0) + qty;\n    }\n  }\n}\n\nconst summaryLines = Object.entries(itemTotals)\n  .map(([name, qty]) => `• ${qty}x ${name}`)\n  .join('\\n');\n\nconst summaryText = count === 0\n  ? '📋 Aucune commande.'\n  : `📋 Résumé\\n\\n${count} commande(s)\\n\\n${summaryLines || '(pas de détails)'}\\n\\nBonne soirée!`;\n\nreturn [{\n  json: {\n    date: new Date().toISOString().split('T')[0],\n    order_count: count,\n    summary_text: summaryText\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
