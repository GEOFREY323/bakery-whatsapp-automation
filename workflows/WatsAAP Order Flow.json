      "name": "If- Is this an other?"
    },
    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n  const raw = \n    item.json.text || \n    item.json.message?.content || \n    item.json.content?.parts?.[0]?.text ||\n    JSON.stringify(item.json);\n  \n  // Pull from the Set node directly — Gemini does not pass these forward\n  const originalMessage = $('set- Nomalise input').item.json.raw_message || '';\n  const customerPhone = $('set- Nomalise input').item.json.customer_Phone || '';\n  const timestamp = $('set- Nomalise input').item.json.timestamp || new Date().toISOString();\n  \n  let parsed;\n  try {\n    const cleaned = raw.replace(/```json|```/g, '').trim();\n    parsed = JSON.parse(cleaned);\n  } catch (e) {\n    results.push({\n      json: {\n        valid: false,\n        reason: 'Invalid JSON from AI',\n        raw_response: raw,\n        original_message: originalMessage,\n        customer_phone: customerPhone,\n        timestamp: timestamp\n      }\n    });\n    continue;\n  }\n  \n  const isValid = \n    parsed.is_order === true &&\n    Array.isArray(parsed.items) &&\n    parsed.items.length > 0 &&\n    parsed.confidence >= 0.7;\n  \n  results.push({\n    json: {\n      valid: isValid,\n      reason: isValid ? null : 'Low confidence or no items',\n      order: parsed,\n      original_message: originalMessage,\n      customer_phone: customerPhone,\n      timestamp: timestamp\n    }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1904,
