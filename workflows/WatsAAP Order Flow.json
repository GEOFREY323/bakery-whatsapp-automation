        "text": "={{ $json.raw_message }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are an order parser for a bakery in Douala, Cameroon. Extract order details from WhatsApp messages. Messages may be in French, English, or Cameroonian pidgin.  Return ONLY valid JSON with this exact structure: {   \"is_order\": true,   \"customer_name\": \"string or null\",   \"items\": [{\"name\": \"string\", \"quantity\": number}],   \"pickup_time\": \"string or null\",   \"confidence\": 0.0,   \"notes\": \"string or null\" }  If the message is unclear, set confidence below 0.7. Do not include any other text. Only JSON."
            }
          ]
        },
        "batching": {}
